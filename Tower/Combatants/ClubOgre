public class ClubOgre extends Enemy {
    public ClubOgre(int lvl) {
        this.LVL = lvl;
        setSTR(lvl);
        setART(lvl);
        setAGI(lvl);
        setDEF(lvl);
        setRES(lvl);

        setStaminaStat(lvl);
        setManaStat(lvl);
        setHealthStat(lvl);

        initialiseStats();
    }
    
    public void setSTR(int lvl) {
        this.STR = 10 + lvl * 5;
    }

    public void setART(int lvl) {
        this.ART = 5 + lvl * 2;
    }
    
    public void setAGI(int lvl) {
        this.AGI = 15;
    }
    
    public void setDEF(int lvl) {
        this.DEF = 10 + lvl * 2;
    }
    
    public void setRES(int lvl) {
        this.RES = 4 + lvl;
    }


    public void setStaminaStat(int lvl) {
        this.staminaStat = (int) (10 + this.LVL * 1.25);
    }

    public void setManaStat(int lvl) {
        this.manaStat = (int) (10 + this.LVL / 4);
    }
    
    public void setHealthStat(int lvl) {
        this.healthStat = (int) (12.5 + this.LVL * 3.75);
    }
    
}